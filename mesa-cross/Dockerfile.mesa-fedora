# Build environment for the aarch64 guest mesa AGAINST FEDORA's libraries.
#
# Unlike Dockerfile.mesa-cross, this one is an aarch64 image run under qemu-user binfmt, so the
# compiler itself is emulated and the build is slow -- hours rather than minutes.
#
# WHY NOT JUST REPACKAGE THE UBUNTU BUILD AS AN RPM
#
# Because the .so files are the payload. A mesa built on Ubuntu links against Ubuntu's glibc and
# libstdc++ and records the version symbols it saw there (GLIBC_2.xx, GLIBCXX_3.4.xx); on a Fedora
# whose glibc is older, the loader refuses them, and on one whose glibc is newer it happens to
# work -- which is worse, because it makes the arrangement look sound until a user on a different
# release hits it. The sonames of everything else (libdrm.so.2, libvulkan.so.1, libGLdispatch.so.0)
# do match across the two distros, so the failure is narrow, version-dependent and silent-ish.
# Building against the target's own libc is the only way to be right about it.
#
# Cross-compiling from an x86_64 Fedora is not an option the way it is on Debian: Fedora has no
# multiarch, so there are no aarch64 -devel packages to link against on an x86_64 host. Emulation
# is the cost of a correct Fedora package.
ARG BASE=fedora:42
FROM --platform=linux/arm64 ${BASE}

# Build tooling, then the -devel packages for platforms=x11,wayland + gallium=zink + the two
# Vulkan drivers + opengl/gbm/glx/egl. Names differ from Debian's throughout, which is most of
# what this file is for.
RUN dnf install -y --setopt=install_weak_deps=False \
      meson ninja-build gcc gcc-c++ pkgconf-pkg-config cmake git xz rpm-build \
      python3-mako python3-yaml python3-packaging \
      bison flex glslang \
      libdrm-devel \
      wayland-devel wayland-protocols-devel \
      libX11-devel libxcb-devel xcb-util-keysyms-devel \
      libXext-devel libXfixes-devel libXdamage-devel libXshmfence-devel \
      libXxf86vm-devel libXrandr-devel \
      expat-devel zlib-devel libzstd-devel \
      vulkan-loader-devel vulkan-headers \
      systemd-devel libglvnd-devel \
 && dnf clean all

WORKDIR /work
