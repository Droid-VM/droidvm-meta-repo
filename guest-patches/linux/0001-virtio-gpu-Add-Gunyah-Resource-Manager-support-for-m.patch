 		vram->map_state = STATE_ERR;
diff --git a/drivers/gpu/drm/virtio/virtgpu_vram.c b/drivers/gpu/drm/virtio/virtgpu_vram.c
index 084e80227433..edf042cc0ca9 100644
--- a/drivers/gpu/drm/virtio/virtgpu_vram.c
+++ b/drivers/gpu/drm/virtio/virtgpu_vram.c
@@ -2,6 +2,7 @@
 #include "virtgpu_drv.h"
 
 #include <linux/dma-mapping.h>
+#include <linux/gunyah_guest.h>
 
 static void virtio_gpu_vram_free(struct drm_gem_object *obj)
 {
@@ -15,6 +16,20 @@ static void virtio_gpu_vram_free(struct drm_gem_object *obj)
 		unmap = drm_mm_node_allocated(&vram->vram_node);
 		spin_unlock(&vgdev->host_visible_lock);
 
+		/*
+		 * Gunyah: release our stage-2 acceptance BEFORE telling the host to
+		 * unmap. virtio_gpu_cmd_unmap's host response frees vram_node via
+		 * drm_mm_remove_node, handing this BAR offset to the next blob; if the
+		 * memparcel is still accepted at that point, the host re-SHAREs the
+		 * reused GPA while the guest stage-2 still maps it and RM rejects it
+		 * with EINVAL (intermittent RESOURCE_MAP_BLOB failures at offset 0).
+		 * Releasing first closes that race.
+		 */
+		if (vram->gunyah_accepted) {
+			gunyah_guest_mem_release(vram->gunyah_handle);
+			vram->gunyah_accepted = false;
+		}
+
 		if (unmap)
 			virtio_gpu_cmd_unmap(vgdev, bo);
 
@@ -46,6 +61,23 @@ static int virtio_gpu_vram_mmap(struct drm_gem_object *obj,
 	if (vram->map_state != STATE_OK)
 		return -EINVAL;
 
+	/*
+	 * Gunyah: the host SHARE'd this blob but cannot push the mapping into a
+	 * protected guest's stage-2. Accept the memparcel here (sleepable context)
+	 * so the IPA at vram_node.start becomes accessible before io_remap.
+	 */
+	if (vram->gunyah_handle && !vram->gunyah_accepted) {
+		ret = gunyah_guest_mem_accept(vram->gunyah_handle,
+					      vram->vram_node.start,
+					      vram->vram_node.size);
+		if (ret) {
+			pr_err("virtio-gpu: gunyah accept failed for blob handle 0x%x: %d\n",
+			       vram->gunyah_handle, ret);
+			return ret;
+		}
+		vram->gunyah_accepted = true;
+	}
+
 	vma->vm_pgoff -= drm_vma_node_start(&obj->vma_node);
 	vm_flags_set(vma, VM_MIXEDMAP | VM_DONTEXPAND);
 	vma->vm_page_prot = vm_get_page_prot(vma->vm_flags);
@@ -206,12 +238,15 @@ int virtio_gpu_vram_create(struct virtio_gpu_device *vgdev,
 	/* Create fake offset */
 	ret = drm_gem_create_mmap_offset(obj);
 	if (ret) {
+		pr_err("VGBLOB-DBG: drm_gem_create_mmap_offset FAILED ret=%d size=%llu\n",
+		       ret, (unsigned long long)params->size);
 		kfree(vram);
 		return ret;
 	}
 
 	ret = virtio_gpu_resource_id_get(vgdev, &vram->base.hw_res_handle);
 	if (ret) {
+		pr_err("VGBLOB-DBG: resource_id_get FAILED ret=%d\n", ret);
 		kfree(vram);
 		return ret;
 	}
@@ -221,6 +256,8 @@ int virtio_gpu_vram_create(struct virtio_gpu_device *vgdev,
 	if (params->blob_flags & VIRTGPU_BLOB_FLAG_USE_MAPPABLE) {
 		ret = virtio_gpu_vram_map(&vram->base);
 		if (ret) {
+			pr_err("VGBLOB-DBG: vram_map FAILED ret=%d size=%llu (host_visible_mm full?)\n",
+			       ret, (unsigned long long)params->size);
 			virtio_gpu_vram_free(obj);
 			return ret;
 		}
diff --git a/drivers/virt/Kconfig b/drivers/virt/Kconfig
index 52eb7e4ba71f..835ace91afb6 100644
--- a/drivers/virt/Kconfig
+++ b/drivers/virt/Kconfig
@@ -49,4 +49,25 @@ source "drivers/virt/acrn/Kconfig"
 
 endif
 
+config GUNYAH_RM_PROBE
+	bool "Gunyah Resource Manager round-trip probe (GET_VMID)"
+	depends on ARM64 && OF
+	default y
+	help
+	  One-shot late_initcall that issues a GET_VMID RM RPC over the
+	  RM message queue (capids read from the "gunyah-resource-manager"
+	  DT node) to validate that this guest can talk to the Gunyah
+	  Resource Manager. Prints a GUNYAH-PROBE: line to dmesg. Disable
+	  once the result is known.
+
+config GUNYAH_GUEST
+	bool "Gunyah guest-side memparcel accept client"
+	depends on ARM64 && OF
+	default y
+	help
+	  Minimal Gunyah Resource Manager client letting this guest ACCEPT a
+	  memparcel the host SHARE'd to it at runtime, mapping it into the
+	  guest's own stage-2. Used by virtio-gpu to map host-visible blobs
+	  (a protected guest cannot receive a host-pushed runtime mapping).
+
 source "drivers/virt/coco/Kconfig"
