diff --git a/drivers/virt/gh_probe.c b/drivers/virt/gh_probe.c
new file mode 100644
index 000000000000..e06c1ecb58ef
--- /dev/null
+++ b/drivers/virt/gh_probe.c
@@ -0,0 +1,371 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Gunyah Resource Manager probe ("命门探针").
+ *
+ * Self-contained (no Gunyah driver dependency); the RM msgq is driven with raw
+ * HVC hypercalls, polling for replies (no IRQ). tx/rx capability IDs come from
+ * the RM-generated "gunyah-resource-manager" DT node (reg = <tx_capid rx_capid>).
+ *
+ *   Stage 1 (late_initcall): GET_VMID -- proves the guest can talk to RM and
+ *             caches this guest's own VMID + the msgq capids for stage 2.
+ *
+ *   Stage 2 (debugfs, runtime): MEM_ACCEPT -- the decisive jump. Accept a
+ *             memparcel the HOST lent to this guest at runtime, map it at a
+ *             chosen guest IPA, then read the magic the host wrote.
+ *
+ * Handshake (all at runtime, ordering enforced by hand):
+ *   1. boot guest; stage 1 prints "vmid=N".
+ *   2. on the HOST: echo a size into the host probe; it lends a region to vmid
+ *      N and prints "handle=0x.. host_pa=0x.. size=0x..".
+ *   3. on the GUEST:
+ *        echo "<handle> <gpa> <size> [perms] [trans]" > /sys/kernel/debug/gh_accept_probe
+ *      where <gpa> is a free guest IPA to map at, [perms] default 0x6 (R|W),
+ *      [trans] default 1 (LEND; 2=SHARE, 0=DONATE). Must match the host lend.
+ *
+ * This is a probe; remove once the result is known.
+ */
+
+#include <linux/arm-smccc.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/types.h>
+#include <linux/uaccess.h>
+#include <linux/unaligned.h>
+
+/* Gunyah hypercall IDs: vendor-hyp fast SMC64 calls. */
+#define GH_HCALL(fn)							\
+	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_64,	\
+			   ARM_SMCCC_OWNER_VENDOR_HYP, (fn))
+#define GH_HCALL_MSGQ_SEND	GH_HCALL(0x801B)
+#define GH_HCALL_MSGQ_RECV	GH_HCALL(0x801C)
+
+#define GH_MSGQ_TX_PUSH		BIT(0)
+#define GH_ERROR_OK		0
+
+/* RM RPC framing (struct gh_rm_rpc_hdr / gh_rm_rpc_reply_hdr). */
+#define GH_RM_RPC_API		0x21	/* version 1 | hdr_words 2 (<<4) */
+#define GH_RM_RPC_TYPE_REQUEST	0x01
+#define GH_RM_RPC_TYPE_REPLY	0x02
+#define GH_RM_RPC_TYPE_MASK	0x03
+
+#define GH_RM_RPC_VM_GET_VMID	0x56000024
+#define GH_RM_RPC_MEM_ACCEPT	0x51000011	/* Qualcomm/Gunyah RM msg id */
+
+#define GH_RM_MSGQ_MSG_SIZE	240
+
+/* MEM_ACCEPT request constants. */
+#define GH_RM_MEM_TYPE_NORMAL	0
+#define GH_RM_TRANS_TYPE_DONATE	0
+#define GH_RM_TRANS_TYPE_LEND	1
+#define GH_RM_TRANS_TYPE_SHARE	2
+#define GH_RM_ACL_X		BIT(0)
+#define GH_RM_ACL_W		BIT(1)
+#define GH_RM_ACL_R		BIT(2)
+#define GH_RM_MEM_ACCEPT_VALIDATE_ACL_ATTRS	BIT(1)
+#define GH_RM_MEM_ACCEPT_MAP_IPA_CONTIGUOUS	BIT(4)
+#define GH_RM_MEM_ACCEPT_SANITIZE_ON_RELEASE	BIT(5)
+#define GH_RM_MEM_ACCEPT_DONE			BIT(7)
+
+struct gh_rm_rpc_hdr {
+	u8 api;
+	u8 type;
+	__le16 seq;
+	__le32 msg_id;
+} __packed;
+
+struct gh_rm_get_vmid_reply {
+	struct gh_rm_rpc_hdr hdr;
+	__le32 err_code;
+	__le32 vmid;
+} __packed;
+
+/*
+ * MEM_ACCEPT request is built dynamically (the ACL entry count varies for the
+ * SHARE experiments), laid out exactly as the Qualcomm RM expects:
+ *   [rpc hdr 8] [accept hdr 12] [acl_desc: n(u32) + n*4B entries]
+ *   [sgl_desc_intf: n(u16) + reserved(u16) + 1*16B entry] [mem_attr: n=0 -> 4B]
+ */
+struct gh_probe_accept_reply {
+	struct gh_rm_rpc_hdr hdr;
+	__le32 err_code;
+	__le16 n_sgl_entries;
+	u8 resp_flags;
+	u8 resp_reserved;
+} __packed;
+
+/* Cached after stage 1; used by the runtime debugfs accept trigger. */
+static u64 gh_tx_capid, gh_rx_capid;
+static u16 gh_self_vmid = U16_MAX;
+static bool gh_rm_ok;
+
+static DEFINE_MUTEX(gh_probe_lock);
+static u8 gh_probe_areq[256] __aligned(8);
+static u8 gh_probe_rxbuf[GH_RM_MSGQ_MSG_SIZE] __aligned(8);
+
+static int gh_probe_msgq_send(u64 capid, void *buff, size_t size)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_1_1_hvc(GH_HCALL_MSGQ_SEND, capid, size, (uintptr_t)buff,
+			  GH_MSGQ_TX_PUSH, 0, &res);
+	return (int)res.a0;
+}
+
+static int gh_probe_msgq_recv(u64 capid, void *buff, size_t size,
+			      size_t *recv_size)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_1_1_hvc(GH_HCALL_MSGQ_RECV, capid, (uintptr_t)buff, size,
+			  0, &res);
+	if (res.a0 == GH_ERROR_OK)
+		*recv_size = res.a1;
+	return (int)res.a0;
+}
+
+/* Poll the rx msgq for a REPLY matching @seq; skip notifications/stale msgs. */
+static int gh_probe_poll_reply(u64 rx_capid, u16 seq, size_t *recv_size)
+{
+	struct gh_rm_rpc_hdr *h = (void *)gh_probe_rxbuf;
+	int err = GH_ERROR_OK, i;
+
+	for (i = 0; i < 2000; i++) {
+		*recv_size = 0;
+		err = gh_probe_msgq_recv(rx_capid, gh_probe_rxbuf,
+					 GH_RM_MSGQ_MSG_SIZE, recv_size);
+		if (err == GH_ERROR_OK && *recv_size >= sizeof(*h) &&
+		    (h->type & GH_RM_RPC_TYPE_MASK) == GH_RM_RPC_TYPE_REPLY &&
+		    le16_to_cpu(h->seq) == seq)
+			return GH_ERROR_OK;
+		udelay(100);
+	}
+	return err ? err : -ETIMEDOUT;
+}
+
+/*
+ * acl_mode: 0 = no VALIDATE_ACL_ATTRS, pass no ACL (RM uses its stored copy)
+ *           1 = VALIDATE_ACL_ATTRS, 1 entry {self_vmid, perms}
+ *           2 = VALIDATE_ACL_ATTRS, 2 entries {self_vmid, perms} + {host_vmid, RWX}
+ * The 2-entry form mirrors what the host passes for a SHARE'd parcel.
+ */
+static int gh_probe_mem_accept(u32 handle, u64 gpa, u64 size, u8 perms, u8 trans,
+			       unsigned int acl_mode, u16 host_vmid)
+{
+	struct gh_probe_accept_reply *reply = (void *)gh_probe_rxbuf;
+	u8 *p = gh_probe_areq;
+	size_t off = 0, recv_size = 0;
+	unsigned int n_acl;
+	void __iomem *map;
+	u32 err_code;
+	u8 flags;
+	u64 magic;
+	int err;
+
+	if (!gh_rm_ok) {
+		pr_info("GUNYAH-PROBE: RM not reachable (stage 1 failed); cannot accept\n");
+		return -ENODEV;
+	}
+
+	n_acl = (acl_mode > 2) ? 2 : acl_mode;
+	flags = GH_RM_MEM_ACCEPT_MAP_IPA_CONTIGUOUS | GH_RM_MEM_ACCEPT_DONE;
+	if (n_acl)
+		flags |= GH_RM_MEM_ACCEPT_VALIDATE_ACL_ATTRS;
+	/* Mirror the RM driver's sanitize policy: normal, non-SHARE => sanitize. */
+	if (trans != GH_RM_TRANS_TYPE_SHARE)
+		flags |= GH_RM_MEM_ACCEPT_SANITIZE_ON_RELEASE;
+
+	memset(p, 0, sizeof(gh_probe_areq));
+	/* RPC header (8) */
+	p[off++] = GH_RM_RPC_API;
+	p[off++] = GH_RM_RPC_TYPE_REQUEST;
+	put_unaligned_le16(2, p + off); off += 2;		/* seq */
+	put_unaligned_le32(GH_RM_RPC_MEM_ACCEPT, p + off); off += 4;
+	/* accept hdr (12) */
+	put_unaligned_le32(handle, p + off); off += 4;
+	p[off++] = GH_RM_MEM_TYPE_NORMAL;
+	p[off++] = trans;
+	p[off++] = flags;
+	p[off++] = 0;						/* reserved1 */
+	put_unaligned_le32(0, p + off); off += 4;		/* validate_label */
+	/* acl_desc: n + entries */
+	put_unaligned_le32(n_acl, p + off); off += 4;
+	if (n_acl >= 1) {
+		put_unaligned_le16(gh_self_vmid, p + off); off += 2;
+		p[off++] = perms;
+		p[off++] = 0;
+	}
+	if (n_acl >= 2) {
+		put_unaligned_le16(host_vmid, p + off); off += 2;
+		p[off++] = GH_RM_ACL_R | GH_RM_ACL_W | GH_RM_ACL_X;
+		p[off++] = 0;
+	}
+	/* sgl_desc_intf: n(u16) + reserved(u16=map_vmid 0) + 1 entry */
+	put_unaligned_le16(1, p + off); off += 2;
+	put_unaligned_le16(0, p + off); off += 2;
+	put_unaligned_le64(gpa, p + off); off += 8;
+	put_unaligned_le64(size, p + off); off += 8;
+	/* mem_attr_desc: n=0 + reserved */
+	put_unaligned_le16(0, p + off); off += 2;
+	put_unaligned_le16(0, p + off); off += 2;
+
+	pr_info("GUNYAH-PROBE: MEM_ACCEPT handle=0x%x vmid=%u trans=%u perms=0x%x gpa=0x%llx size=0x%llx flags=0x%02x acl_mode=%u host_vmid=%u (req %zuB)\n",
+		handle, gh_self_vmid, trans, perms, gpa, size, flags,
+		acl_mode, host_vmid, off);
+
+	err = gh_probe_msgq_send(gh_tx_capid, gh_probe_areq, off);
+	if (err) {
+		pr_info("GUNYAH-PROBE: MEM_ACCEPT send failed, gunyah_error=%d\n",
+			err);
+		return -EIO;
+	}
+
+	err = gh_probe_poll_reply(gh_rx_capid, 2, &recv_size);
+	if (err) {
+		pr_info("GUNYAH-PROBE: MEM_ACCEPT no reply (gunyah_error=%d)\n",
+			err);
+		return -EIO;
+	}
+	if (recv_size < offsetof(struct gh_probe_accept_reply, n_sgl_entries)) {
+		pr_info("GUNYAH-PROBE: MEM_ACCEPT short reply (%zu bytes)\n",
+			recv_size);
+		return -EIO;
+	}
+
+	err_code = le32_to_cpu(reply->err_code);
+	if (err_code) {
+		pr_info("GUNYAH-PROBE: MEM_ACCEPT REJECTED by RM, err_code=0x%x => guest-accept NOT granted for this VM\n",
+			err_code);
+		return -EACCES;
+	}
+
+	{
+		/* resp sgl payload only present if the reply carried it */
+		unsigned int rn =
+			recv_size >= offsetof(struct gh_probe_accept_reply,
+					      resp_flags) ?
+			le16_to_cpu(reply->n_sgl_entries) : 0;
+		pr_info("GUNYAH-PROBE: MEM_ACCEPT OK (err 0, resp_n_sgl=%u) => parcel mapped at gpa 0x%llx. RM GRANTS guest accept!\n",
+			rn, gpa);
+	}
+
+	/* Cacheable read so it is coherent with the host's cacheable write. */
+	map = ioremap_cache(gpa, PAGE_SIZE);
+	if (!map) {
+		pr_info("GUNYAH-PROBE: ioremap_cache(0x%llx) failed; try `devmem 0x%llx`\n",
+			gpa, gpa);
+		return 0;
+	}
+	magic = readq(map);
+	iounmap(map);
+	pr_info("GUNYAH-PROBE: read 0x%016llx at gpa 0x%llx (expect host magic) => END-TO-END %s\n",
+		magic, gpa, magic ? "DATA VISIBLE" : "zero/uninit");
+	return 0;
+}
+
+static ssize_t gh_accept_write(struct file *f, const char __user *ubuf,
+			       size_t len, loff_t *ppos)
+{
+	u64 handle = 0, gpa = 0, size = 0;
+	unsigned int perms = GH_RM_ACL_R | GH_RM_ACL_W;
+	unsigned int trans = GH_RM_TRANS_TYPE_LEND;
+	unsigned int acl_mode = 1, host_vmid = 0;
+	char buf[128];
+	int n, ret;
+
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+
+	n = sscanf(buf, "%llx %llx %llx %x %x %x %x", &handle, &gpa, &size,
+		   &perms, &trans, &acl_mode, &host_vmid);
+	if (n < 3 || !handle || !gpa || !size) {
+		pr_info("GUNYAH-PROBE: usage: echo \"<handle> <gpa> <size> [perms] [trans] [acl_mode] [host_vmid]\" > gh_accept_probe\n"
+			"  trans: 1=LEND 2=SHARE ; acl_mode: 0=no-acl 1=self 2=self+host_vmid\n");
+		return -EINVAL;
+	}
+
+	mutex_lock(&gh_probe_lock);
+	ret = gh_probe_mem_accept((u32)handle, gpa, size, (u8)perms, (u8)trans,
+				  acl_mode, (u16)host_vmid);
+	mutex_unlock(&gh_probe_lock);
+
+	return ret ? ret : len;
+}
+
+static const struct file_operations gh_accept_fops = {
+	.owner = THIS_MODULE,
+	.write = gh_accept_write,
+};
+
+static int __init gh_probe_init(void)
+{
+	struct gh_rm_get_vmid_reply *reply = (void *)gh_probe_rxbuf;
+	size_t recv_size = 0;
+	struct device_node *np;
+	int err, i;
+
+	np = of_find_compatible_node(NULL, NULL, "gunyah-resource-manager");
+	if (!np) {
+		pr_info("GUNYAH-PROBE: no \"gunyah-resource-manager\" node in DT (RM did not grant rm-rpc)\n");
+		return 0;
+	}
+	if (of_property_read_u64_index(np, "reg", 0, &gh_tx_capid) ||
+	    of_property_read_u64_index(np, "reg", 1, &gh_rx_capid)) {
+		pr_info("GUNYAH-PROBE: node present but reg=<tx_capid rx_capid> missing/short\n");
+		of_node_put(np);
+		return 0;
+	}
+	of_node_put(np);
+
+	pr_info("GUNYAH-PROBE: tx_capid=%llu rx_capid=%llu -> sending GET_VMID\n",
+		gh_tx_capid, gh_rx_capid);
+
+	{
+		struct gh_rm_rpc_hdr req = {
+			.api	= GH_RM_RPC_API,
+			.type	= GH_RM_RPC_TYPE_REQUEST,
+			.seq	= cpu_to_le16(1),
+			.msg_id	= cpu_to_le32(GH_RM_RPC_VM_GET_VMID),
+		};
+		err = gh_probe_msgq_send(gh_tx_capid, &req, sizeof(req));
+	}
+	if (err) {
+		pr_info("GUNYAH-PROBE: msgq_send failed, gunyah_error=%d\n", err);
+		return 0;
+	}
+
+	for (i = 0; i < 1000; i++) {
+		err = gh_probe_msgq_recv(gh_rx_capid, gh_probe_rxbuf,
+					 sizeof(gh_probe_rxbuf), &recv_size);
+		if (err == GH_ERROR_OK && recv_size)
+			break;
+		udelay(100);
+	}
+	if (!recv_size) {
+		pr_info("GUNYAH-PROBE: TIMEOUT, no reply after %d tries (last gunyah_error=%d)\n",
+			i, err);
+		return 0;
+	}
+
+	gh_self_vmid = le32_to_cpu(reply->vmid) & 0xffff;
+	gh_rm_ok = true;
+	pr_info("GUNYAH-PROBE: recv=%zu bytes err_code=0x%x vmid=%u => RM ROUND-TRIP OK\n",
+		recv_size, le32_to_cpu(reply->err_code), gh_self_vmid);
+
+	debugfs_create_file("gh_accept_probe", 0200, NULL, NULL,
+			    &gh_accept_fops);
+	pr_info("GUNYAH-PROBE: stage 2 armed. After the host lends to vmid %u, run:\n"
+		"  echo \"<handle> <gpa> <size> [perms] [trans]\" > /sys/kernel/debug/gh_accept_probe\n",
+		gh_self_vmid);
+	return 0;
+}
+late_initcall(gh_probe_init);
diff --git a/drivers/virt/gunyah_guest.c b/drivers/virt/gunyah_guest.c
new file mode 100644
index 000000000000..44cf382e18f4
--- /dev/null
+++ b/drivers/virt/gunyah_guest.c
@@ -0,0 +1,236 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Gunyah guest-side Resource Manager client.
+ *
+ * A (protected) guest cannot receive a runtime stage-2 mapping pushed by the
+ * host: the guest owns its own stage-2. Instead the host SHARE's a memparcel and
+ * the guest ACCEPTs it here, mapping it into its own stage-2 at a chosen IPA.
+ *
+ * The RM msgq is driven with raw HVC hypercalls (no Gunyah driver dependency);
+ * the tx/rx capability ids come from the RM-generated "gunyah-resource-manager"
+ * DT node (reg = <tx_capid rx_capid>). Validated end-to-end: a SHARE'd parcel is
+ * accepted with no ACL (RM uses its stored copy) and the host data is visible.
+ */
+
+#define pr_fmt(fmt) "gunyah_guest: " fmt
+
+#include <linux/arm-smccc.h>
+#include <linux/delay.h>
+#include <linux/export.h>
+#include <linux/gunyah_guest.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/types.h>
+#include <linux/unaligned.h>
+
+/* Gunyah hypercall IDs: vendor-hyp fast SMC64 calls. */
+#define GH_HCALL(fn)							\
+	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_64,	\
+			   ARM_SMCCC_OWNER_VENDOR_HYP, (fn))
+#define GH_HCALL_MSGQ_SEND	GH_HCALL(0x801B)
+#define GH_HCALL_MSGQ_RECV	GH_HCALL(0x801C)
+#define GH_MSGQ_TX_PUSH		BIT(0)
+#define GH_ERROR_OK		0
+
+/* RM RPC framing. */
+#define GH_RM_RPC_API		0x21	/* version 1 | hdr_words 2 (<<4) */
+#define GH_RM_RPC_TYPE_REQUEST	0x01
+#define GH_RM_RPC_TYPE_REPLY	0x02
+#define GH_RM_RPC_TYPE_MASK	0x03
+
+#define GH_RM_RPC_MEM_ACCEPT	0x51000011
+#define GH_RM_RPC_MEM_RELEASE	0x51000014
+
+#define GH_RM_MSGQ_MSG_SIZE	240
+
+/* MEM_ACCEPT constants (production form proven in bring-up). */
+#define GH_RM_MEM_TYPE_NORMAL	0
+#define GH_RM_TRANS_TYPE_SHARE	2
+#define GH_RM_MEM_ACCEPT_MAP_IPA_CONTIGUOUS	BIT(4)
+#define GH_RM_MEM_ACCEPT_DONE			BIT(7)
+
+struct gh_rpc_reply {
+	u8 api;
+	u8 type;
+	__le16 seq;
+	__le32 msg_id;
+	__le32 err_code;
+} __packed;
+
+static u64 gg_tx_capid, gg_rx_capid;
+static bool gg_ready;
+static u16 gg_seq = 1;
+static DEFINE_MUTEX(gg_lock);
+static u8 gg_txbuf[64] __aligned(8);
+static u8 gg_rxbuf[GH_RM_MSGQ_MSG_SIZE] __aligned(8);
+
+static int gg_msgq_send(u64 capid, void *buff, size_t size)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_1_1_hvc(GH_HCALL_MSGQ_SEND, capid, size, (uintptr_t)buff,
+			  GH_MSGQ_TX_PUSH, 0, &res);
+	return (int)res.a0;
+}
+
+static int gg_msgq_recv(u64 capid, void *buff, size_t size, size_t *recv_size)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_1_1_hvc(GH_HCALL_MSGQ_RECV, capid, (uintptr_t)buff, size,
+			  0, &res);
+	if (res.a0 == GH_ERROR_OK)
+		*recv_size = res.a1;
+	return (int)res.a0;
+}
+
+/* Send @txlen bytes, poll for the REPLY matching @seq, return RM err_code. */
+static int gg_rpc(size_t txlen, u16 seq, u32 *err_code)
+{
+	struct gh_rpc_reply *r = (void *)gg_rxbuf;
+	size_t rxlen = 0;
+	int err, i;
+
+	err = gg_msgq_send(gg_tx_capid, gg_txbuf, txlen);
+	if (err) {
+		pr_err("msgq_send failed: gunyah_error=%d\n", err);
+		return -EIO;
+	}
+
+	for (i = 0; i < 2000; i++) {
+		rxlen = 0;
+		err = gg_msgq_recv(gg_rx_capid, gg_rxbuf, sizeof(gg_rxbuf),
+				   &rxlen);
+		if (err == GH_ERROR_OK && rxlen >= sizeof(*r) &&
+		    (r->type & GH_RM_RPC_TYPE_MASK) == GH_RM_RPC_TYPE_REPLY &&
+		    le16_to_cpu(r->seq) == seq) {
+			*err_code = le32_to_cpu(r->err_code);
+			return 0;
+		}
+		udelay(100);
+	}
+	pr_err("RPC timeout (last gunyah_error=%d)\n", err);
+	return -ETIMEDOUT;
+}
+
+bool gunyah_guest_available(void)
+{
+	return READ_ONCE(gg_ready);
+}
+EXPORT_SYMBOL_GPL(gunyah_guest_available);
+
+int gunyah_guest_mem_accept(u32 handle, u64 gpa, u64 size)
+{
+	u8 *p = gg_txbuf;
+	size_t off = 0;
+	u32 err_code = 0;
+	u16 seq;
+	int ret;
+
+	if (!READ_ONCE(gg_ready))
+		return -ENODEV;
+
+	mutex_lock(&gg_lock);
+	seq = ++gg_seq;
+
+	/* RPC header (8) */
+	p[off++] = GH_RM_RPC_API;
+	p[off++] = GH_RM_RPC_TYPE_REQUEST;
+	put_unaligned_le16(seq, p + off); off += 2;
+	put_unaligned_le32(GH_RM_RPC_MEM_ACCEPT, p + off); off += 4;
+	/* accept hdr (12) */
+	put_unaligned_le32(handle, p + off); off += 4;
+	p[off++] = GH_RM_MEM_TYPE_NORMAL;
+	p[off++] = GH_RM_TRANS_TYPE_SHARE;
+	p[off++] = GH_RM_MEM_ACCEPT_MAP_IPA_CONTIGUOUS | GH_RM_MEM_ACCEPT_DONE;
+	p[off++] = 0;						/* reserved1 */
+	put_unaligned_le32(0, p + off); off += 4;		/* validate_label */
+	/* acl_desc: n=0 (SHARE accepted with no ACL; RM uses its stored copy) */
+	put_unaligned_le32(0, p + off); off += 4;
+	/* sgl_desc_intf: n(u16)=1, reserved(u16=map_vmid 0), one {ipa,size} */
+	put_unaligned_le16(1, p + off); off += 2;
+	put_unaligned_le16(0, p + off); off += 2;
+	put_unaligned_le64(gpa, p + off); off += 8;
+	put_unaligned_le64(size, p + off); off += 8;
+	/* mem_attr_desc: n=0 */
+	put_unaligned_le16(0, p + off); off += 2;
+	put_unaligned_le16(0, p + off); off += 2;
+
+	ret = gg_rpc(off, seq, &err_code);
+	mutex_unlock(&gg_lock);
+
+	if (ret)
+		return ret;
+	if (err_code) {
+		pr_err("MEM_ACCEPT handle=0x%x gpa=0x%llx rejected, err_code=0x%x\n",
+		       handle, gpa, err_code);
+		return -EACCES;
+	}
+	pr_debug("MEM_ACCEPT handle=0x%x mapped at gpa=0x%llx size=0x%llx\n",
+		 handle, gpa, size);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(gunyah_guest_mem_accept);
+
+int gunyah_guest_mem_release(u32 handle)
+{
+	u8 *p = gg_txbuf;
+	size_t off = 0;
+	u32 err_code = 0;
+	u16 seq;
+	int ret;
+
+	if (!READ_ONCE(gg_ready))
+		return -ENODEV;
+
+	mutex_lock(&gg_lock);
+	seq = ++gg_seq;
+
+	/* RPC header (8) */
+	p[off++] = GH_RM_RPC_API;
+	p[off++] = GH_RM_RPC_TYPE_REQUEST;
+	put_unaligned_le16(seq, p + off); off += 2;
+	put_unaligned_le32(GH_RM_RPC_MEM_RELEASE, p + off); off += 4;
+	/* release payload: u32 handle, u8 flags, u24 reserved */
+	put_unaligned_le32(handle, p + off); off += 4;
+	put_unaligned_le32(0, p + off); off += 4;	/* flags=0 | reserved */
+
+	ret = gg_rpc(off, seq, &err_code);
+	mutex_unlock(&gg_lock);
+
+	if (ret)
+		return ret;
+	if (err_code) {
+		pr_err("MEM_RELEASE handle=0x%x err_code=0x%x\n", handle, err_code);
+		return -EIO;
+	}
+	return 0;
+}
+EXPORT_SYMBOL_GPL(gunyah_guest_mem_release);
+
+static int __init gunyah_guest_init(void)
+{
+	struct device_node *np;
+
+	np = of_find_compatible_node(NULL, NULL, "gunyah-resource-manager");
+	if (!np) {
+		pr_info("no \"gunyah-resource-manager\" DT node; RM client disabled\n");
+		return 0;
+	}
+	if (of_property_read_u64_index(np, "reg", 0, &gg_tx_capid) ||
+	    of_property_read_u64_index(np, "reg", 1, &gg_rx_capid)) {
+		pr_info("RM node present but reg=<tx rx> missing\n");
+		of_node_put(np);
+		return 0;
+	}
+	of_node_put(np);
+
+	WRITE_ONCE(gg_ready, true);
+	pr_info("RM client ready (tx_capid=%llu rx_capid=%llu)\n",
+		gg_tx_capid, gg_rx_capid);
+	return 0;
+}
+core_initcall(gunyah_guest_init);
diff --git a/include/linux/gunyah_guest.h b/include/linux/gunyah_guest.h
new file mode 100644
index 000000000000..716c38564093
--- /dev/null
+++ b/include/linux/gunyah_guest.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Minimal Gunyah guest-side Resource Manager client: lets a (protected) guest
+ * accept a memparcel the host SHARE'd to it at runtime, mapping it into the
+ * guest's own stage-2 at a chosen IPA. Used by virtio-gpu to map host-visible
+ * blobs (the host cannot push a runtime stage-2 mapping into a protected guest).
+ */
+#ifndef _LINUX_GUNYAH_GUEST_H
+#define _LINUX_GUNYAH_GUEST_H
+
+#include <linux/types.h>
+
+#if IS_ENABLED(CONFIG_GUNYAH_GUEST)
+/* True once the RM msgq capability ids were discovered (DT node present). */
+bool gunyah_guest_available(void);
+/*
+ * Accept a host-SHARE'd memparcel @handle and map it contiguously at guest
+ * physical address @gpa (size @size). Returns 0 on success, negative on error.
+ */
+int gunyah_guest_mem_accept(u32 handle, u64 gpa, u64 size);
+/* Release a previously accepted memparcel @handle. */
+int gunyah_guest_mem_release(u32 handle);
+#else
+static inline bool gunyah_guest_available(void) { return false; }
+static inline int gunyah_guest_mem_accept(u32 handle, u64 gpa, u64 size) { return -ENODEV; }
+static inline int gunyah_guest_mem_release(u32 handle) { return -ENODEV; }
+#endif
+
+#endif /* _LINUX_GUNYAH_GUEST_H */
diff --git a/include/uapi/linux/virtio_gpu.h b/include/uapi/linux/virtio_gpu.h
index be109777d10d..5f7d07d78b62 100644
--- a/include/uapi/linux/virtio_gpu.h
+++ b/include/uapi/linux/virtio_gpu.h
@@ -447,7 +447,10 @@ struct virtio_gpu_resource_map_blob {
 struct virtio_gpu_resp_map_info {
 	struct virtio_gpu_ctrl_hdr hdr;
 	__u32 map_info;
-	__u32 padding;
+	/* Was padding. On Gunyah, the resource-manager memparcel handle the guest
+	 * must accept to map the host-visible blob itself; 0 when not applicable.
+	 */
+	__u32 gunyah_handle;
 };
 
